{
  "name": "sdlc",
  "private": true,
  "version": "1.0.0",
  "description": "Salesforce source for the AI-assisted delivery pipeline (Jira SDLC project).",
  "scripts": {
    "lint": "eslint \"force-app/**/{aura,lwc}/**/*.js\" --no-error-on-unmatched-pattern",
    "test": "npm run test:unit",
    "test:unit": "sfdx-lwc-jest -- --passWithNoTests",
    "test:unit:coverage": "sfdx-lwc-jest --coverage -- --passWithNoTests",
    "prettier": "prettier --write \"force-app/**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml}\"",
    "prettier:verify": "prettier --check \"force-app/**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml}\""
  },
  "devDependencies": {
    "@lwc/eslint-plugin-lwc": "^2.0.0",
    "@prettier/plugin-xml": "^3.4.1",
    "@salesforce/eslint-config-lwc": "^3.6.0",
    "@salesforce/eslint-plugin-lightning": "^1.0.0",
    "@salesforce/sfdx-lwc-jest": "^7.0.1",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.8.3",
    "prettier": "^3.3.3",
    "prettier-plugin-apex": "^2.2.2"
  }
}
