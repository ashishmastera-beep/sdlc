<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Allows intended Account viewers to read contract end dates and renewal status without editing the date.</description>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.Contract_End_Date__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>false</editable>
        <field>Account.Renewal_Due__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <label>Sales Contract Viewer</label>
</PermissionSet>
