{
  "$comment": "Single source of pipeline settings. Scripts look up statuses by NAME (statuses.*.name); IDs are for reference and JQL. Change by PR only.",
  "jira": {
    "site": "https://ashishmastera.atlassian.net",
    "projectKey": "SDLC",
    "projectId": "10066",
    "boardId": 67,
    "issueTypes": { "story": "10081", "bug": "10082" },
    "statuses": {
      "draft":         { "id": "10072", "name": "Draft" },
      "readyToWork":   { "id": "10075", "name": "Ready to Work" },
      "enrich":        { "id": "10073", "name": "Enrichment In Progress" },
      "needsInfo":     { "id": "10076", "name": "Needs Info" },
      "enriched":      { "id": "10077", "name": "Enrichment Completed" },
      "specApproved":  { "id": "10078", "name": "Enrichment Approved" },
      "readyForBuild": { "id": "10079", "name": "Ready for Build" },
      "inBuild":       { "id": "10080", "name": "In Build" },
      "prCreated":     { "id": "10081", "name": "PR Created" },
      "approved":      { "id": "10082", "name": "Approved" },
      "deployed":      { "id": "10083", "name": "Deployed" },
      "released":      { "id": "10074", "name": "Released" },
      "blocked":       { "id": "10084", "name": "Blocked" }
    },
    "fields": {
      "acceptanceCriteria": "customfield_10107",
      "riskLevel":          "customfield_10114",
      "specPr":             "customfield_10113",
      "approvedSpecSha":    "customfield_10108",
      "buildPr":            "customfield_10112",
      "agentState":         "customfield_10109",
      "agentRun":           "customfield_10111",
      "agentAttempts":      "customfield_10110"
    },
    "agentStates": ["Idle", "Queued", "Running", "Failed"]
  },
  "github": {
    "repo": "ashishmastera-beep/sdlc",
    "defaultBranch": "main",
    "branchPrefixes": { "spec": "spec/", "copilot": "copilot/", "fix": "fix/" },
    "events": ["jira.enrich", "jira.spec_approved", "jira.build"]
  },
  "limits": {
    "wip": 3,
    "maxAgentAttempts": 3,
    "maxFixRounds": 2,
    "coverageMin": 85,
    "staleRunningHours": 4,
    "reconcileQueuedAfterMinutes": 10
  },
  "orgs": {
    "agent":      { "environment": "agent-sandbox", "alias": "agent" },
    "qa":         { "environment": "qa",            "alias": "qa" },
    "uat":        { "environment": "uat",           "alias": "uat", "enabled": true },
    "production": { "environment": "production",    "alias": "prod" }
  }
}
